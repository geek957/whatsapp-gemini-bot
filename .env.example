# Copy to .env and source it for local runs. .env is gitignored.
# In GitHub, the first three go in Secrets and the rest in Variables.

PROVIDER=greenapi

# Green API instance (green-api.com console)
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=

# Google AI Studio key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the primary returns 503/429 under load.
GEMINI_MODEL_FALLBACKS=gemini-2.5-flash
GEMINI_TEMPERATURE=0
# Gemini 2.5+ charge reasoning tokens against maxOutputTokens, which truncates the
# visible reply. 0 disables thinking (flash only), -1 lets the model decide.
GEMINI_THINKING_BUDGET=0
# A cap, not a reservation: you are billed for tokens actually generated.
GEMINI_MAX_OUTPUT_TOKENS=32768

# Chats to serve. Groups end in @g.us. Find them with: python3 -m bot.cli doctor
# Leaving this empty serves EVERY chat the linked account is in.
WHATSAPP_CHAT_IDS=

# any_image | command | command_or_caption
TRIGGER_MODE=command_or_caption
COMMAND_PREFIX=/ask

# queue | history | both
READ_MODE=both

# Set true when the Green API number is also the account posting the images, e.g. a
# personal automation group you post into yourself. Requires the Green API toggle
# "Receive webhooks on messages sent from phone". The bot's own API replies are always
# excluded, so this cannot cause a reply loop.
INCLUDE_OUTGOING=false
# Kept wide: scheduled runs can be badly delayed, and dedupe state -- not this window --
# is what prevents duplicate replies.
WINDOW_MINUTES=1440
MAX_IMAGES_PER_REPLY=6
MAX_REPLIES_PER_RUN=5

# Long answers are split across WhatsApp messages rather than truncated.
MAX_REPLY_CHARS=4000
MAX_REPLY_PARTS=12

# prompts/default.md is the general-purpose prompt; clinical-summary.md enforces the
# strict case-summary template. Compare models with scripts/bench_models.py.
PROMPT_PATH=prompts/default.md
STATE_PATH=.state/state.json
LOG_LEVEL=INFO

# Official Cloud API instead (1:1 only, no groups)
# PROVIDER=meta
# META_PHONE_NUMBER_ID=
# META_ACCESS_TOKEN=
